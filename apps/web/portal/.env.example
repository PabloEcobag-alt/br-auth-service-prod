# ─────────────────────────────────────────────
# Next.js / Auth.js (NextAuth v5) Configuration
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────

# Secret used to sign/encrypt the session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# The public base URL of this Next.js app (used by Auth.js for callbacks).
AUTH_URL=https://localhost:3000

# OpenIddict client credentials registered in the auth service seed.
# These must match the values in the API's Seeders/ApplicationSeeder.cs.
AUTH_HRMS_CLIENT_ID=portal-client
AUTH_HRMS_CLIENT_SECRET=

# The issuer URL of the internal-auth-service (OpenIddict authority).
AUTH_ISSUER=https://localhost:5001/

# Set to 0 to allow Node.js server-side fetch to trust
# the local self-signed HTTPS certificate created by mkcert.
# NEVER set this to 0 in production.
NODE_TLS_REJECT_UNAUTHORIZED=0
