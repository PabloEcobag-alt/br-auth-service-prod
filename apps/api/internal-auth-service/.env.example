# ─────────────────────────────────────────────
# SMTP / Email Configuration
# Used by the password-reset email flow.
# Tested with Brevo (formerly Sendinblue) SMTP relay.
# ─────────────────────────────────────────────

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587

# Brevo login (the "login" field shown in your SMTP & API Keys page)
SMTP_USERNAME=

# Brevo SMTP key (NOT your account password — generate one in Brevo dashboard)
SMTP_PASSWORD=

# The "From" address that appears in outgoing emails
SMTP_FROM=noreply@yourdomain.com

# ─────────────────────────────────────────────
# Client Applications URLs
# ─────────────────────────────────────────────
PORTAL_URL=https://localhost:3000/
HRMS_URL=https://localhost:3001/
POS_URL=https://localhost:3002/
SCMS_URL=https://localhost:3003/
OOS_URL=https://localhost:3004/
CRMS_URL=https://localhost:3005/

# Auth Service URLs
LOGIN_URL=https://localhost:5001/Account/Login


